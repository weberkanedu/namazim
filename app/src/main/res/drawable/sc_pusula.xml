<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher shortcut icon "pusula": the dock glyph on a navy disc with a gold ring. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#14213D" />
            <stroke android:width="1.5dp" android:color="#E8BE74" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_nav_kible" android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp" />
</layer-list>
