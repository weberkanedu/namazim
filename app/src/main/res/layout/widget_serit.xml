<?xml version="1.0" encoding="utf-8"?>
<!-- W3 "İnce şerit" 4×1: small rose, the vakit, a live countdown, the seven slices, a round Kıldım. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/wg_serit_bg"
    android:paddingStart="10dp" android:paddingEnd="12dp">
    <ImageView android:id="@+id/w_rose" android:layout_width="58dp" android:layout_height="58dp" android:scaleType="fitCenter"
        android:src="@drawable/ic_logo_mono" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical">
        <TextView android:id="@+id/w_k" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
            android:text="İKİNDİ VAKTİ" android:textColor="#E8BE74" android:textSize="9.5sp" android:textStyle="bold" android:letterSpacing="0.16" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
            <TextView android:id="@+id/w_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
                android:text="15:21" android:fontFamily="serif" android:textColor="#F3EEE3" android:textSize="24sp" />
        <Chronometer android:id="@+id/w_cd" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:countDown="true" android:fontFamily="serif" android:textColor="#E8BE74" android:textSize="16sp" />
        </LinearLayout>
        <ImageView android:id="@+id/w_strip" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="5dp"
            android:scaleType="fitXY" android:contentDescription="@null" />
    </LinearLayout>
    <TextView android:id="@+id/w_btn" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="10dp"
        android:background="@drawable/wg_check" android:gravity="center" android:text="✓" android:textColor="#E8BE74" android:textSize="18sp" android:textStyle="bold" />
</LinearLayout>
