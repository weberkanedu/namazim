<?xml version="1.0" encoding="utf-8"?>
<!-- W1 "Harem penceresi" 4×2 (design/widget/widget-secenekler.html). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/wg_card" android:clipToOutline="true">
    <ImageView android:id="@+id/w_photo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:src="@drawable/harem_mekke_gun" android:contentDescription="@null" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY"
        android:src="@drawable/wg_photo_shade" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
        android:paddingStart="16dp" android:paddingEnd="12dp" android:paddingTop="14dp" android:paddingBottom="14dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
        <TextView android:id="@+id/w_k" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
            android:text="İKİNDİ VAKTİ" android:textColor="#E8BE74" android:textSize="9.5sp" android:textStyle="bold" android:letterSpacing="0.16" />
        <TextView android:id="@+id/w_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
            android:layout_marginTop="3dp" android:text="15:21" android:fontFamily="serif" android:textColor="#F3EEE3" android:textSize="36sp" />
            <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
                android:text="vaktin çıkmasına" android:textColor="#D9DEE8" android:textSize="11sp" />
        <Chronometer android:id="@+id/w_cd" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:countDown="true" android:fontFamily="serif" android:textColor="#E8BE74" android:textSize="20sp" />
        <TextView android:id="@+id/w_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
            android:layout_marginTop="6dp" android:background="@drawable/wg_btn_gold" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="5dp" android:paddingBottom="5dp" android:text="✓ Kıldım" android:textColor="#0B1322" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="112dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/w_r0" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:background="@drawable/wg_row_off" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp">
                <TextView android:id="@+id/w_n0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
                    android:text="İmsak" android:textColor="#C9D0DE" android:textSize="11.5sp" />
                <TextView android:id="@+id/w_t0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
                    android:text="05:53" android:fontFamily="serif" android:textColor="#F3EEE3" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_r1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:background="@drawable/wg_row_off" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp">
                <TextView android:id="@+id/w_n1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
                    android:text="Öğle" android:textColor="#C9D0DE" android:textSize="11.5sp" />
                <TextView android:id="@+id/w_t1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
                    android:text="12:37" android:fontFamily="serif" android:textColor="#F3EEE3" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_r2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:background="@drawable/wg_row_off" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp">
                <TextView android:id="@+id/w_n2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
                    android:text="İkindi" android:textColor="#C9D0DE" android:textSize="11.5sp" />
                <TextView android:id="@+id/w_t2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
                    android:text="15:21" android:fontFamily="serif" android:textColor="#F3EEE3" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_r3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:background="@drawable/wg_row_off" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp">
                <TextView android:id="@+id/w_n3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
                    android:text="Akşam" android:textColor="#C9D0DE" android:textSize="11.5sp" />
                <TextView android:id="@+id/w_t3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
                    android:text="17:48" android:fontFamily="serif" android:textColor="#F3EEE3" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_r4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:background="@drawable/wg_row_off" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp">
                <TextView android:id="@+id/w_n4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
                    android:text="Yatsı" android:textColor="#C9D0DE" android:textSize="11.5sp" />
                <TextView android:id="@+id/w_t4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
                    android:text="19:08" android:fontFamily="serif" android:textColor="#F3EEE3" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
